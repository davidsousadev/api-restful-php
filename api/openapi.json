{
  "openapi": "3.0.3",
  "info": {
    "title": "API RESTful PHP - Usuários",
    "description": "API RESTful simples para gerenciamento de usuários, construída em PHP com SQLite e hospedada na Vercel.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual"
    }
  ],
  "paths": {
    "/usuarios": {
      "get": {
        "summary": "Listar usuários",
        "description": "Retorna a lista de todos os usuários cadastrados.",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Criar usuário",
        "description": "Cria um novo usuário. O corpo da requisição deve ser um JSON com nome e email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da operação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Atualizar usuário",
        "description": "Atualiza um usuário existente. O corpo da requisição deve ser url-encoded (application/x-www-form-urlencoded) com id, nome e email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da operação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Deletar usuário",
        "description": "Remove um usuário pelo id. O corpo da requisição deve ser url-encoded (application/x-www-form-urlencoded) com id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da operação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@example.com"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": [
          "nome",
          "email"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@example.com"
          }
        }
      },
      "UserUpdateInput": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@example.com"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "success": {
            "type": "string",
            "example": "Usuário criado com sucesso"
          },
          "error": {
            "type": "string",
            "example": "Dados incompletos"
          }
        }
      }
    }
  }
}